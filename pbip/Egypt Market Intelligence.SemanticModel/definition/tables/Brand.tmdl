	partition Brand = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Brand",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Brand", type text}, {"BrandAR", type text}, {"Category", type text}, {"Company", type text}, {"Origin", type text}, {"Color", type text}, {"Shape", type text}, {"Sort", Int64.Type}, {"CategoryAR", type text}, {"ShareOfSearch12M", type number}, {"Interest2021", type number}, {"InterestLast12M", type number}, {"CategorySort", Int64.Type}, {"Tone", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
