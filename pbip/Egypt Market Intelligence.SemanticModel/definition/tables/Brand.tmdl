table Brand
	lineageTag: ce665d30-afcd-52a7-bdea-de2a58dc7532

	measure 'Category Leader' =
			VAR t = ADDCOLUMNS ( VALUES ( Brand[Brand] ), "@s", [Share of Search] )
			RETURN MAXX ( TOPN ( 1, t, [@s], DESC ), Brand[Brand] )
		lineageTag: aa02c5fb-7704-5560-9ac9-75ae611beecb

	measure 'Leader National Share' = MAXX ( VALUES ( Brand[Brand] ), [Share of Search] )
		formatString: 0.0%
		lineageTag: 0d3eeeca-14d2-50c1-8bf5-655af3b8ffbd

	measure 'Governorates Led' =
			VAR top1 = [Category Leader]
			RETURN COUNTROWS ( FILTER ( VALUES ( Governorate[GovCode] ), [Leader] = top1 ) ) & " of 27"
		lineageTag: 46604620-f1c7-5778-9831-5f96f2397ace

	measure 'Search Growth' = DIVIDE ( [Interest Last 12M], [Interest 2021] )
		formatString: 0.0
		lineageTag: 76232996-6715-5a5c-95bf-c82e6262c91b

	measure 'Category Leader Color' = LOOKUPVALUE ( Brand[Tone], Brand[Brand], [Category Leader] )
		lineageTag: 1d43c43a-2418-5518-b21d-5d6464954227

	measure 'Category Runner' =
			VAR t = ADDCOLUMNS ( VALUES ( Brand[Brand] ), "@s", [Share of Search] )
			RETURN MINX ( TOPN ( 1, TOPN ( 2, t, [@s], DESC ), [@s], ASC ), Brand[Brand] )
		lineageTag: e8a97c5d-a47e-5d85-947c-c103c6450431

	measure 'Fastest Grower' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( Brand[Brand] ), "@g", [Search Growth] ), NOT ISBLANK ( [@g] ) )
			RETURN MAXX ( TOPN ( 1, t, [@g], DESC ), Brand[Brand] ) & " · " & FORMAT ( MAXX ( t, [@g] ), "0.0" ) & "x"
		lineageTag: ef397069-6ae6-54b3-98be-722ac815d3f1

	measure 'Search Insight' =
			VAR s = [Leader National Share]
			RETURN [Category Leader] & " holds " & FORMAT ( s, "0%" ) & " of Google searches in its category over the last 12 months and leads "
			    & [Governorates Led] & " governorates; " & [Category Runner] & " is the runner-up. Search share measures attention, not sales."
		lineageTag: e424e0bb-8dfc-5e8e-8a7f-c1c77b68cb86

