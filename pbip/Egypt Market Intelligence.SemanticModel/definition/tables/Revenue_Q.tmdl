	partition Revenue_Q = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Revenue_Q",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Company", type text}, {"Quarter", type text}, {"QuarterEnd", type date}, {"Year", Int64.Type}, {"RevenueEGP", type number}, {"BacktestEGP", type number}, {"ForecastEGP", type number}, {"Lo80", type number}, {"Hi80", type number}, {"FX", type number}, {"ActualUSD", type number}, {"ForecastUSD", type number}, {"Seasonal naive", type number}, {"Seasonal naive + drift", type number}, {"Holt-Winters (ETS)", type number}, {"Theta", type number}, {"SARIMA", type number}, {"Trend + season OLS", type number}, {"CPI", type number}, {"RealEGP", type number}, {"ForecastLow", type number}, {"ForecastHigh", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
