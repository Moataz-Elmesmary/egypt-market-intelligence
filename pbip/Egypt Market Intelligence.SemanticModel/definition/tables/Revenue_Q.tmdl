table Revenue_Q
	lineageTag: f7edf3f7-3938-5b2b-9825-f6de8e934240

	measure 'Actual (EGP M)' = SUM ( Revenue_Q[RevenueEGP] )
		formatString: #,0
		lineageTag: 2e92b82f-e872-5a9e-81e9-af967eb07a19

	measure 'Ensemble Forecast' = SUM ( Revenue_Q[ForecastEGP] )
		formatString: #,0
		lineageTag: e2b9f33a-3bb0-52ad-bd44-d242b5d131dd

	measure 'Low 80%' = SUM ( Revenue_Q[Lo80] )
		formatString: #,0
		lineageTag: 24b1a6a0-b0cf-552a-8ad8-68cea1955662

	measure 'High 80%' = SUM ( Revenue_Q[Hi80] )
		formatString: #,0
		lineageTag: f6c7aca2-b059-58f3-9138-6d18f11b5ab0

	measure 'Backtest (EGP M)' = SUM ( Revenue_Q[BacktestEGP] )
		formatString: #,0
		lineageTag: 36a315a2-972b-5f42-8224-bfc23f21270e

	measure 'Real (2021 prices)' = SUM ( Revenue_Q[RealEGP] )
		formatString: #,0
		lineageTag: 400b04c1-10e0-5b61-be96-ee4b01184d50

	measure 'Forecast Low' = SUM ( Revenue_Q[ForecastLow] )
		formatString: #,0
		lineageTag: 7c13be2a-66c4-5505-b64a-81f5cecc33f5

	measure 'Forecast High' = SUM ( Revenue_Q[ForecastHigh] )
		formatString: #,0
		lineageTag: d432f5fc-f603-5f68-866e-6892e229070e

	measure 'Scenario Forecast' = SWITCH ( SELECTEDVALUE ( 'Scenario'[Ord], 2 ), 1, [Forecast Low], 3, [Forecast High], [Ensemble Forecast] )
		formatString: #,0
		lineageTag: fd060b1e-82ad-588c-be93-093c7da11edc

	measure 'Scenario 2027 (EGP B)' = DIVIDE ( CALCULATE ( [Scenario Forecast], Revenue_Q[Year] = 2027 ), 1000 )
		formatString: 0.0
		lineageTag: 31d6237a-0551-530d-9b99-8c436a91a4e2

	measure 'Actual (backtest quarters)' = IF ( NOT ISBLANK ( [Backtest (EGP M)] ), [Actual (EGP M)] )
		formatString: #,0
		lineageTag: 5dc23fbc-487a-5e52-954a-a734aceedb6f

	measure 'Backtest Error' = DIVIDE ( [Backtest (EGP M)] - [Actual (backtest quarters)], [Actual (backtest quarters)] )
		formatString: +0.0%;-0.0%
		lineageTag: fd059f54-7031-571c-acc8-2624afb59b05

	measure 'Seasonal naive path' = SUM ( Revenue_Q[Seasonal naive] )
		formatString: #,0
		lineageTag: c496db18-7f3b-5441-8031-db677c76cb54

	measure 'Naive + drift path' = SUM ( Revenue_Q[Seasonal naive + drift] )
		formatString: #,0
		lineageTag: 78fde3a5-70c6-5fc2-8901-93600ba1ff05

	measure 'Holt-Winters path' = SUM ( Revenue_Q[Holt-Winters (ETS)] )
		formatString: #,0
		lineageTag: b03a71db-a74b-537b-8395-45bb2421d4d5

	measure 'Theta path' = SUM ( Revenue_Q[Theta] )
		formatString: #,0
		lineageTag: 6ff36ea6-e63e-5bd2-a63a-41c321c5bcc2

	measure 'SARIMA path' = SUM ( Revenue_Q[SARIMA] )
		formatString: #,0
		lineageTag: 55206521-cff0-58d4-8144-d864ee154294

	measure 'OLS path' = SUM ( Revenue_Q[Trend + season OLS] )
		formatString: #,0
		lineageTag: 6c381078-a5dc-5311-8e1f-06d03b1d6779

