table Notes
	lineageTag: 0820e96c-9006-502a-be2d-075b3288cdff

	measure 'Show Note' =
			VAR cat = SELECTEDVALUE ( Brand[Category] )
			VAR co = SELECTEDVALUE ( 'Company'[Company] )
			VAR nc = SELECTEDVALUE ( 'Notes'[Category] )
			VAR nco = SELECTEDVALUE ( 'Notes'[Company] )
			RETURN IF ( ( nc = "" || nc = cat ) && ( nco = "" || nco = co ), 1 )
		formatString: 0
		lineageTag: 954da423-a975-5558-8ffe-807309a06020

	column Page
		dataType: string
		summarizeBy: none
		sourceColumn: Page
