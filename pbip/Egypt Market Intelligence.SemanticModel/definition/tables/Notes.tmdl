	partition Notes = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Notes",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Page", type text}, {"Category", type text}, {"Company", type text}, {"Ord", Int64.Type}, {"Tone", type text}, {"Title", type text}, {"TitleAR", type text}, {"Body", type text}, {"Source", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
