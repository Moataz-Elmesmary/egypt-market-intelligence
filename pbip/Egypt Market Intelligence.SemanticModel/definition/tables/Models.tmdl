		lineageTag: d1b2ac8b-9715-5ca7-85db-c23d86548588

	measure 'Selection Error' = DIVIDE ( SUM ( 'Models'[MAPE_Select] ), 100 )
		formatString: 0.0%
		lineageTag: 770b97e6-3588-53b1-92fc-c278f6ae2c07

	measure 'Ensemble Weight' = SUM ( 'Models'[Weight] )
		formatString: 0%
		lineageTag: 0ef5e51d-d8c8-5a64-aa7b-19c3579e837f

	column Company
