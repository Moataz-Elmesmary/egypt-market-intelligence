	partition Models = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Models",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Company", type text}, {"Model", type text}, {"MAPE_Select", type number}, {"MAPE_Holdout", type number}, {"Weight", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
