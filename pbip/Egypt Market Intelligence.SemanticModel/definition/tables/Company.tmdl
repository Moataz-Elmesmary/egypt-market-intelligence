	partition Company = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Company",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Company", type text}, {"CompanyAR", type text}, {"Ticker", type text}, {"Segment", type text}, {"SegmentAR", type text}, {"Revenue2025", type number}, {"Forecast2026", type number}, {"Forecast2027", type number}, {"Growth2026", type number}, {"Growth2027", type number}, {"Revenue2025USD", type number}, {"Forecast2027USD", type number}, {"EnsembleMAPE", type number}, {"BestModel", type text}, {"BestModelMAPE", type number}, {"Blend", type text}, {"Reliability", type text}, {"ReliabilityAR", type text}, {"InsightEN", type text}, {"InsightAR", type text}, {"Sort", Int64.Type}, {"RealGrowth2027", type number}, {"InflationPart", type number}, {"Forecast2027Low", type number}, {"Forecast2027High", type number}, {"MASE", type number}, {"CoverageIn", Int64.Type}, {"CoverageN", Int64.Type}, {"Coverage", type text}, {"ErrH1", type number}, {"ErrH2", type number}, {"ErrH3", type number}, {"ErrH4", type number}, {"BacktestMAPE", type number}, {"RealMethodMAPE", type number}, {"MethodNote", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
