table Company
	lineageTag: f6b23844-f766-5e23-92da-9c6122041844

	measure 'Company Name' = SELECTEDVALUE ( 'Company'[Company], "All four companies" )
		lineageTag: 2c89c61c-ea9a-5912-a0e3-d948bb16f553

	measure 'Revenue 2025 (EGP B)' = DIVIDE ( SUM ( 'Company'[Revenue2025] ), 1000 )
		formatString: 0.0
		lineageTag: 4ad5b798-7803-537e-a325-cf63694a5b08

	measure 'Forecast 2027 (EGP B)' = DIVIDE ( SUM ( 'Company'[Forecast2027] ), 1000 )
		formatString: 0.0
		lineageTag: 23fe5efa-e682-5cbe-8b90-3db81a25d236

	measure 'Growth 2027' = DIVIDE ( SUM ( 'Company'[Forecast2027] ), SUM ( 'Company'[Forecast2026] ) ) - 1
		formatString: +0.0%;-0.0%
		lineageTag: 454f6d7a-e733-5fd0-b065-4ee7d3d1ad89

	measure 'Forecast Error' = DIVIDE ( AVERAGE ( 'Company'[EnsembleMAPE] ), 100 )
		formatString: 0.0%
		lineageTag: c2a22b0e-cb87-53b9-aec2-21a9ffaa87db

	measure Confidence = SELECTEDVALUE ( 'Company'[Reliability], "Pick a company" )
		lineageTag: e1dec3e6-a856-5b2a-ae6b-74c8a54d7ba3

	measure 'Confidence Color' = SWITCH ( SELECTEDVALUE ( 'Company'[Reliability] ), "High", "#0B6E69", "Medium", "#C2922F", "Low", "#8A6516", "#4F5F5C" )
		lineageTag: b3851cca-4ac5-5c4b-8c75-b67a45c89614

	measure 'Best Model' = SELECTEDVALUE ( 'Company'[BestModel], "Pick a company" )
		lineageTag: aba8bd52-69eb-5a61-b903-22482eb6bf5f

	measure 'Model Blend' = SELECTEDVALUE ( 'Company'[Blend], "Pick a company" )
		lineageTag: 9333222e-1ff6-51c4-bea3-7d3e595bb5d2

	measure 'Real Growth 2027' = AVERAGE ( 'Company'[RealGrowth2027] )
		formatString: +0.0%;-0.0%
		lineageTag: 37e19f5d-e7f4-5441-b2a6-a18642f60c74

	measure 'MASE Score' = AVERAGE ( 'Company'[MASE] )
		formatString: 0.00
		lineageTag: cf237ce2-8cd5-555d-8ede-871d42227552

	measure 'Band Coverage' = SELECTEDVALUE ( 'Company'[Coverage], "Pick a company" )
		lineageTag: 79277ffd-a57e-5198-8a73-b3513fc99ccf

	measure 'Method Note' = SELECTEDVALUE ( 'Company'[MethodNote], "Pick a company to see how its forecast was tested." )
		lineageTag: a804b7ec-0b09-55c8-90b7-6b6caf871387

	measure 'Accuracy Note' = "How it is scored: each model is refit on the history up to a cut-off, forecasts the next 4 quarters, and is compared with what actually happened (rolling-origin backtest). The 3 lowest-error models are blended by inverse error. The 80% band is the 80th percentile of the ensemble's own past misses at each horizon, so it widens with the horizon."
		lineageTag: d57955ec-ed6d-59a0-8e08-b1f8c8d77b54

	measure 'Forecast Insight' = SELECTEDVALUE ( 'Company'[InsightEN], "Pick a company above: its forecast, how the ensemble is built and how far off it was on quarters it never saw." )
		lineageTag: 2119628c-de2b-5ab1-8fca-2fbe34437824

