	partition Months = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Months",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Month", type date}, {"Year", Int64.Type}, {"MonthLabel", type text}, {"EventCola", type text}, {"EventColaAR", type text}, {"EventApps", type text}, {"EventAppsAR", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
