	partition Backtest = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Backtest",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Company", type text}, {"Origin", type text}, {"Horizon", Int64.Type}, {"Quarter", type text}, {"Actual", type number}, {"Forecast", type number}, {"Lo80", type number}, {"Hi80", type number}, {"Inside", Int64.Type}, {"APE", type number}})
