	partition Knowledge = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Knowledge",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Id", Int64.Type}, {"Dataset", type text}, {"Entity", type text}, {"EntityAR", type text}, {"Attr", type text}, {"Period", type text}, {"Value", type number}, {"Unit", type text}, {"Source", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
