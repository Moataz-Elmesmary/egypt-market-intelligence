	partition KPI = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="KPI",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Page", type text}, {"Ord", Int64.Type}, {"Key", type text}, {"Label", type text}, {"LabelAR", type text}, {"Value", type number}, {"Display", type text}, {"Sub", type text}, {"SubAR", type text}, {"Icon", type text}, {"Source", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
