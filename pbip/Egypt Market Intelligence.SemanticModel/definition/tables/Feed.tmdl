table Feed
	lineageTag: fa55e017-cd5f-582a-b14a-ab553fd2f427

	column Dataset
		dataType: string
		summarizeBy: none
		sourceColumn: Dataset
		lineageTag: c629cc3b-824d-5101-af59-fdfd19011374

		annotation SummarizationSetBy = User

	column Seq
		dataType: int64
		summarizeBy: none
		sourceColumn: Seq
		lineageTag: f8e7ae63-c6ac-5fb0-baf4-19493b20d8c0

