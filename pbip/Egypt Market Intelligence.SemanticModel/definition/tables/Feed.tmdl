		sourceColumn: Json
		lineageTag: fe8fbe24-7e71-5d7d-9504-55211ff52ad9

		annotation SummarizationSetBy = User

	partition Feed = m
		mode: import
		source =
				let
				    Bytes = if Text.StartsWith(XlsxPath, "http") then Web.Contents(XlsxPath) else File.Contents(XlsxPath),
				    Source = Excel.Workbook(Bytes, null, true),
				    Data = Source{[Item="Feed",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Dataset", type text}, {"Seq", Int64.Type}, {"Json", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
