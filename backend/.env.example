# Copy to backend/.env. The key stays on the machine that runs the gateway; the report never sees it.
GEMINI_API_KEY=
# optional: the first model to try (the gateway falls back to others on 404/429/5xx)
GEMINI_MODEL=gemini-3.5-flash
# optional: where Power BI Desktop is installed (for Microsoft.PowerBI.AdomdClient)
# PBI_BIN=C:\Program Files\Microsoft Power BI Desktop\bin
